{
  "name": "@knight-ai-av/ai-stack-builder",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/ensure-safe-next-sharp.mjs",
    "build": "next build",
    "build:firebase": "node scripts/build-firebase-release.mjs",
    "audit:runtime": "node scripts/ensure-safe-next-sharp.mjs && npm audit --omit=optional --audit-level=high",
    "brand:build": "python scripts/build-brand-assets.py",
    "brand:check": "python scripts/build-brand-assets.py --check",
    "render:google": "node scripts/render-cloud-run-service.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify": "npm run brand:check && npm run lint && npm run typecheck && npm test && npm run build:firebase && npm run verify:deployment"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tsx": "4.23.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
